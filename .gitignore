# =============================================================================
# .gitignore — BoviCheck (Flutter)
#
# Regra de ouro: só artefatos gerados e SEGREDOS ficam de fora.
# Código-fonte, testes, pubspec.yaml/pubspec.lock, analysis_options.yaml e as
# pastas de plataforma (android/, ios/, web/...) DEVEM ser versionados — sem
# eles um clone limpo não builda e o CI não roda.
# =============================================================================

# --- Diversos ---
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog
.history
.svn/
.swiftpm/
migrate_working_dir/

# --- IntelliJ / Android Studio ---
*.iml
*.ipr
*.iws
.idea/

# --- Flutter / Dart (gerados) ---
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# --- Símbolos / ofuscação de build ---
app.*.symbols
app.*.map.json

# --- Artefatos de build do Android Studio ---
/android/app/debug
/android/app/profile
/android/app/release

# --- Segredos: NUNCA versionar ---
# O template versionado é o `.env.example` (sem valores).
# A chave da Groq deve ser configurada no app (Configurações → Consultor IA),
# onde fica apenas nas preferências do dispositivo.
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
